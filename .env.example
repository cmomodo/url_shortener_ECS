# Copy this file to .env and fill in your real values.
# .env is ignored by git; this template is safe to commit.

# GitHub repository to configure. Optional if `gh repo view` works locally.
# REPO=OWNER/REPO

# GitHub Actions repository variables.
AWS_REGION=
TF_STATE_BUCKET=
TF_STATE_KEY=
TF_BOOTSTRAP_STATE_KEY=
TF_IN_AUTOMATION=true

# GitHub Actions secret.
AWS_TERRAFORM_ROLE_ARN=
